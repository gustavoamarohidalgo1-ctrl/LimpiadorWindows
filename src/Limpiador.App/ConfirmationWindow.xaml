<Window x:Class="Limpiador.App.ConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar las acciones seleccionadas" Width="780" Height="730" MinWidth="620" MinHeight="550" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Plan de limpieza, antes de continuar" TextWrapping="Wrap" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="OmissionsNotice" Foreground="{DynamicResource Caution}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Solo se ejecutarán las acciones aceptadas de este plan. Revisa sus rutas y consecuencias; se comprobarán de nuevo antes de aplicar cualquier cambio." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
    <TabControl x:Name="PlanTabs" Grid.Row="1" Margin="0,0,0,4" AutomationProperties.Name="Acciones aceptadas y elementos omitidos del plan">
      <TabItem x:Name="AcceptedTab" Header="Acciones aceptadas">
    <ListBox x:Name="ItemsList" BorderBrush="{DynamicResource Line}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Acciones que se van a ejecutar">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding RiskLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding SizeText}" Margin="0,4,0,0"/><TextBlock Text="{Binding ActionLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" Foreground="{DynamicResource Caution}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding CostText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBox Text="{Binding PathsText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="12" Padding="0,5,0,0"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
      </TabItem>
      <TabItem x:Name="OmissionsTab" Header="Elementos omitidos">
        <ListBox x:Name="OmissionsList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Elementos que no se ejecutarán y motivo de su omisión">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{DynamicResource Caution}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
    <StackPanel x:Name="Acknowledgements" Grid.Row="2" Margin="0,18,0,18"><CheckBox x:Name="Reviewed" Checked="Acknowledgement_Changed" Unchecked="Acknowledgement_Changed"><TextBlock Text="He revisado el plan, incluidos los elementos omitidos, y acepto los costes y consecuencias de las acciones aceptadas." TextWrapping="Wrap"/></CheckBox><CheckBox x:Name="Irreversible" Checked="Acknowledgement_Changed" Unchecked="Acknowledgement_Changed" Margin="0,8,0,0"><TextBlock Text="Entiendo que las acciones irreversibles no se podrán deshacer." TextWrapping="Wrap"/></CheckBox></StackPanel>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right"><Button Content="Volver a revisar" IsCancel="True"/><Button x:Name="Confirm" Content="Ejecutar las acciones" Style="{StaticResource PrimaryButton}" IsEnabled="False" IsDefault="False" Click="Confirm_Click" Margin="0" AutomationProperties.HelpText="No se activa pulsando Enter. Usa el ratón o enfoca este botón y pulsa Espacio."/></WrapPanel>
  </Grid>
</Window>
