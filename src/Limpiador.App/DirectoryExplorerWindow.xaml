<Window x:Class="Limpiador.App.DirectoryExplorerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorador de espacio" Width="1120" Height="820" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Dónde está el espacio" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Explora las carpetas medidas en el último análisis. Sus tamaños incluyen el contenido de las subcarpetas; no indican cuánto es seguro eliminar." Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
      <TextBlock Text="{Binding FreshnessText}" TextWrapping="Wrap" Foreground="{DynamicResource Caution}" Margin="0,0,0,12"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Content="Raíces" Click="Roots_Click" AutomationProperties.HelpText="Vuelve a las carpetas principales del análisis."/>
      <Button Grid.Column="1" Content="Subir" Click="Up_Click" IsEnabled="{Binding CanGoUp}" AutomationProperties.HelpText="Abre la carpeta superior. Atajo Alt más flecha arriba."/>
      <TextBox Grid.Column="2" Text="{Binding CurrentPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Carpeta que se está explorando. La ruta se puede copiar."/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><Label Content="Buscar carpetas en todo el análisis" Target="{Binding ElementName=DirectorySearch}" Padding="0,0,0,5" FontSize="12"/><TextBox x:Name="DirectorySearch" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Buscar carpetas por nombre o ruta en el análisis"/></StackPanel>
      <StackPanel Grid.Column="1"><Label Content="Orden" Target="{Binding ElementName=DirectorySort}" Padding="0,0,0,5" FontSize="12"/><ComboBox x:Name="DirectorySort" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="DirectoriesGrid" ItemsSource="{Binding VisibleDirectories}" SelectedItem="{Binding SelectedDirectory}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" BorderBrush="{DynamicResource Line}" HorizontalGridLinesBrush="{DynamicResource SoftLine}" MouseDoubleClick="Directory_DoubleClick" PreviewKeyDown="Directory_KeyDown" AutomationProperties.Name="Carpetas medidas. Haz doble clic o pulsa Enter para ver sus subcarpetas.">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Carpeta" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="7,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Tamaño medido" Binding="{Binding SizeText}" Width="130"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Margin" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
          <DataGridTextColumn Header="Archivos" Binding="{Binding FilesText}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Margin" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Text="{Binding DirectorySummary}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding RelatedTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Caution}" FontSize="12" Margin="0,4,8,0"/></StackPanel>
      <Button Grid.Column="1" Content="Ver subcarpetas" Click="Descend_Click" IsEnabled="{Binding HasSelectedDirectory}" FontSize="12" Padding="10,6"/>
      <Button Grid.Column="2" Content="Abrir en Explorer" Click="OpenExplorer_Click" IsEnabled="{Binding CanOpenExplorer}" FontSize="12" Padding="10,6" Margin="0"/>
    </Grid>
    <DataGrid x:Name="RelatedGrid" Grid.Row="5" ItemsSource="{Binding RelatedItems}" SelectedItem="{Binding SelectedCandidate}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" BorderBrush="{DynamicResource Line}" EnableRowVirtualization="True" AutomationProperties.Name="Candidatos del análisis relacionados con esta carpeta. No se marcan para limpiar desde este explorador.">
      <DataGrid.Columns><DataGridTextColumn Header="Candidato relacionado" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Riesgo" Binding="{Binding RiskLabel}" Width="85"/><DataGridTextColumn Header="Acción propuesta" Binding="{Binding ActionLabel}" Width="180"/></DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="6" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Expander Header="{Binding WarningsTitle}" Margin="0,0,16,0" Visibility="{Binding HasWarnings, Converter={StaticResource BooleanVisibility}}"><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Caution}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Ver en resultados" Click="ShowCandidate_Click" IsEnabled="{Binding CanShowCandidate}" AutomationProperties.HelpText="Abre el candidato en la ventana principal para revisarlo; no marca su casilla ni limpia nada."/><Button Content="Cerrar" IsCancel="True" Margin="0"/></StackPanel>
    </Grid>
  </Grid>
</Window>
